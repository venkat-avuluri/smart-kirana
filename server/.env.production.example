# SMART KIRANA - Production Environment Configuration Template
# DO NOT commit actual secrets or live production credentials to Git!

# Environment mode
NODE_ENV=production

# Server Port (Render sets this dynamically via PORT env var)
PORT=10000

# MongoDB Atlas Production Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas cluster credentials.
# Ensure your Render/server IP or 0.0.0.0/0 (with strong password) is whitelisted in Atlas Network Access.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/smart_kirana_prod?retryWrites=true&w=majority&appName=SmartKiranaProd

# JWT Authentication Secret
# Must be a cryptographically secure random string with minimum 64 characters in production.
# Example generator: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_strong_64_character_random_hex_secret_here

# JWT Expiration Period (e.g. 8h or 12h for store cashier shift)
JWT_EXPIRE=12h

# Production CORS Origin
# Comma-separated list of allowed frontend domains. Do NOT use wildcards (*) in production!
CORS_ORIGIN=https://smart-kirana.vercel.app,https://your-custom-shop-domain.com

# Initial Store Owner Setup (Used ONLY on clean initial database seed)
DEFAULT_ADMIN_USERNAME=owner
DEFAULT_ADMIN_PASSWORD=SetAStrongStoreOwnerPassword123!
DEFAULT_ADMIN_NAME=Shop Owner
